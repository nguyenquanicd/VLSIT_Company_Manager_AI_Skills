ng m\u7841?i
\par }\pard\plain \s35\qj \fi709\li0\ri0\sa80\nowidctlpar\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0 \f31\fs28\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\lang1036\langfe1033\langnp1036 1. C\u225?c h\u224?nh vi vi ph\u7841?m ph\u225?p lu\u7853?t v\u7873? th
\u432?\u417?ng m\u7841?i bao g\u7891?m:
\par a) Vi ph\u7841?m quy \u273?\u7883?nh v\u7873? \u273?\u259?ng k\u253? kinh doanh; gi\u7845?y ph\u233?p kinh doanh c\u7911?a th\u432?\u417?ng nh\u226?n; th\u224?nh l\u7853?p v\u224? ho\u7841?t \u273?\u7897?ng c\u7911?a V\u259?n ph\u242?ng \u273?\u7841?i di\u7879?n, Chi nh\u225?nh c\u7911?a th\u432?\u417?ng nh\u226?n Vi\u7879?
t Nam v\u224? c\u7911?a th\u432?\u417?ng nh\u226?n n\u432?\u7899?c ngo\u224?i;
\par b) Vi ph\u7841?m quy \u273?\u7883?nh v\u7873? h\u224?ng h\u243?a, d\u7883?ch v\u7909? kinh doanh trong n\u432?\u7899?c v\u224? h\u224?ng h\u243?a, d\u7883?ch v\u7909? xu\u7845?t kh\u7849?u, nh\u7853?p kh\u7849?u; t\u7841?m nh\u7853?p, t\u225?i xu\u7845?t, t\u7841?m xu\u7845?t, t\u225?i nh\u7853?p; chuy\u7875?n kh\u7849?u; qu\u225? c
\u7843?nh;
\par }{\lang1046\langfe1033\langnp1046 c) Vi ph\u7841?m ch\u7871? \u273?\u7897? thu\u7871?, h\u243?a \u273?\u417?n, ch\u7913?ng t\u7915?, s\u7893? v\u224? b\u225?o c\u225?o k\u7871? to\u225?n;
\par d) Vi ph\u7841?m quy \u273?\u7883?nh v\u7873? gi\u225? h\u224?ng h\u243?a, d\u7883?ch v\u7909?;
\par \u273?) Vi ph\u7841?m quy \u273?\u7883?nh v\u7873? ghi nh\u227?n h\u224?ng h\u243?a l\u432?u th\u244?ng trong n\u432?\u7899?c v\u224? h\u224?ng h\u243?a xu\u7845?t kh\u7849?u, nh\u7853?p kh\u7849?u;
\par e) Bu\u244?n l\u7853?u, kinh doanh h\u224?ng nh\u7853?p l\u7853?u, bu\u244?n b\u225?n h\u224?ng gi\u7843? ho\u7863?c nguy\u234?n li\u7879?u, v\u7853?t li\u7879?u ph\u7909?c v\u7909? cho s\u7843?n xu\u7845?t h\u224?ng gi\u7843?, kinh doanh tr\u225?i ph\u233?p;
\par g) Vi ph\u7841?m c\u225?c quy \u273?\u7883?nh li\u234?n quan \u273?\u7871?n ch\u7845?t l\u432?\u7907?ng h\u224?ng h\u243?a, d\u7883?ch v\u7909? kinh doanh trong n\u432?\u7899?c v\u224? h\u224?ng h\u243?a, d\u7883?ch v\u7909? xu\u7845?t kh\u7849?u, nh\u7853?p kh\u7849?u;
\par }{\expnd0\expndtw-4\lang1046\langfe1033\langnp1046 h) Gian l\u7853?n, l\u7915?a d\u7889?i kh\u225?ch h\u224?ng khi mua b\u225?n h\u224?ng h\u243?a, cung \u7913?ng d\u7883?ch v\u7909?;
\par }{\lang1046\langfe1033\langnp1046 i) Vi ph\u7841?m c\u225?c quy \u273?\u7883?nh li\u234?n quan \u273?\u7871?n b\u7843?o v\u7879? quy\u7873?n l\u7907?i c\u7911?a ng\u432?\u7901?i ti\u234?u d\u249?ng;
\par k) Vi ph\u7841?m quy \u273?\u7883?nh v\u7873? quy\u7873?n s\u7903? h\u7919?u tr\u237? tu\u7879? \u273?\u7889?i v\u7899?i h\u224?ng h\u243?a, d\u7883?ch v\u7909? kinh doanh trong n\u432?\u7899?c v\u224? xu\u7845?t kh\u7849?u, nh\u7853?p kh\u7849?u;
\par l) Vi ph\u7841?m quy \u273?\u7883?nh v\u7873? xu\u7845?t x\u7913? h\u224?ng h\u243?a;
\par }{\expnd-1\expndtw-6 m) C\u225?c vi ph\u7841?m kh\u225?c trong ho\u7841?t \u273?\u7897?ng th\u432?\u417?ng m\u7841?i theo quy \u273?\u7883?nh c\u7911?a ph\u225?p lu\u7853?t.
\par }{2. Ch\u237?nh ph\u7911? quy \u273?\u7883?nh c\u7909? th\u7875? c\u225?c h\u224?nh vi vi ph\u7841?m ph\u225?p lu\u7853?t v\u7873? th\u432?\u417?ng m\u7841?i }{\loch\af31\dbch\af0\hich\f31 \u273?\u432?\u7907?}{c quy \u273?\u7883?nh t\u7841?i kho\u7843?n 1 \u272?i\u7873?u n\u224?y.
\par }\pard\plain \s34\qj \fi709\li0\ri0\sb120\sa180\nowidctlpar\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0 \b\i\f31\fs28\lang1036\langfe1033\cgrid\langnp1036\langfenp1033 {\i0 \u272?i\u7873?u 321.}{ H\u236?nh th\u7913?c x\u7917? l\u253? vi ph\u7841?m ph\u225?p lu\u7853?t v
\u7873? th\u432?\u417?ng m\u7841?i
\par }\pard\plain \s35\qj \fi709\li0\ri0\sa120\nowidctlpar\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0 \f31\fs28\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\lang1036\langfe1033\langnp1036 1. Tu\u7923? theo t\u237?nh ch\u7845?t, m\u7913?c \u273?\u7897? vi ph\u7841?
m v\u224? h\u7853?u qu\u7843? x\u7843?y ra, t\u7893? ch\u7913?c, c\u225? nh\u226?n b\u7883? x\u7917? l\u253? theo m\u7897?t trong c\u225?c h\u236?nh th\u7913?c sau \u273?\u226?y:
