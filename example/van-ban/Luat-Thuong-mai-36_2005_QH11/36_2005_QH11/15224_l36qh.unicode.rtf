\par }\pard\plain \s35\qj \fi709\li0\ri0\sa120\nowidctlpar\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0 \f31\fs28\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\lang1036\langfe1033\langnp1036 Nh\u432?\u7907?ng quy\u7873?n th\u432?\u417?ng m\u7841?i l\u224? ho\u7841?t 
\u273?\u7897?ng th\u432?\u417?ng m\u7841?i, theo \u273?\u243? b\u234?n nh\u432?\u7907?ng quy\u7873?n cho ph\u233?p v\u224? y\u234?u c\u7847?u b\u234?n nh\u7853?n quy\u7873?n t\u7921? m\u236?nh ti\u7871?n h\u224?nh vi\u7879?c mua b\u225?n h\u224?ng ho\u225?, cung \u7913?ng d\u7883?ch v\u7909? theo c\u225?c \u273?i\u7873?u ki\u7879?
n sau \u273?\u226?y:
\par 1. Vi\u7879?c mua b\u225?n h\u224?ng ho\u225?, cung \u7913?ng d\u7883?ch v\u7909? \u273?\u432?\u7907?c ti\u7871?n h\u224?nh theo c\u225?ch th\u7913?c t\u7893? ch\u7913?c kinh doanh do b\u234?n nh\u432?\u7907?ng quy\u7873?n quy \u273?\u7883?nh v\u224? \u273?\u432?\u7907?c g\u7855?n v\u7899?i nh\u227?n hi\u7879?u h\u224?ng ho\u225?, t
\u234?n th\u432?\u417?ng m\u7841?i, b\u237? quy\u7871?t kinh doanh, kh\u7849?u hi\u7879?u kinh doanh, bi\u7875?u t\u432?\u7907?ng kinh doanh, qu\u7843?ng c\u225?o c\u7911?a b\u234?n nh\u432?\u7907?ng quy\u7873?n;
\par 2. B\u234?n nh\u432?\u7907?ng quy\u7873?n c\u243? quy\u7873?n ki\u7875?m so\u225?t v\u224? tr\u7907? gi\u250?p cho b\u234?n nh\u7853?n quy\u7873?n trong vi\u7879?c \u273?i\u7873?u h\u224?nh c\u244?ng vi\u7879?c kinh doanh.
\par }\pard\plain \s34\qj \fi709\li0\ri0\sb120\sa180\nowidctlpar\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0 \b\i\f31\fs28\lang1036\langfe1033\cgrid\langnp1036\langfenp1033 {\i0 \u272?i\u7873?u 285.}{ H\u7907?p \u273?\u7891?ng nh\u432?\u7907?ng quy\u7873?n th\u432?\u417?ng m
\u7841?i
