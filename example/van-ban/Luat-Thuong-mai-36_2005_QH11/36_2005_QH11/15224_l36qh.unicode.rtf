\u7841?i ph\u7843?i \u273?\u432?\u7907?c l\u7853?p th\u224?nh v\u259?n b\u7843?n ho\u7863?c b\u7857?ng h\u236?nh th\u7913?c kh\u225?c c\u243? gi\u225? tr\u7883? ph\u225?p l\u253? t\u432?\u417?ng \u273?\u432?\u417?ng.
\par }\pard\plain \s34\qj \fi709\li0\ri0\sb120\sa180\nowidctlpar\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0 \b\i\f31\fs28\lang1036\langfe1033\cgrid\langnp1036\langfenp1033 {\i0 \u272?i\u7873?u 286.}{ Quy\u7873?n c\u7911?a th\u432?\u417?ng nh\u226?n nh\u432?\u7907?ng quy\u7873?
n
\par }\pard\plain \s35\qj \fi709\li0\ri0\sa120\nowidctlpar\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0 \f31\fs28\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\lang1036\langfe1033\langnp1036 \tab }{\expnd0\expndtw-4 Tr\u7915? tr\u432?\u7901?ng h\u7907?p c\u243?
 th\u7887?a thu\u7853?n kh\u225?c, th\u432?\u417?ng nh\u226?n nh\u432?\u7907?ng quy\u7873?n c\u243? c\u225?c quy\u7873?n sau \u273?\u226?y:
\par }{1. Nh\u7853?n ti\u7873?n nh\u432?\u7907?ng quy\u7873?n;
\par 2. T\u7893? ch\u7913?c qu\u7843?ng c\u225?o cho h\u7879? th\u7889?ng nh\u432?\u7907?ng quy\u7873?n th\u432?\u417?ng m\u7841?i v\u224? m\u7841?ng l\u432?\u7899?i nh\u432?\u7907?ng quy\u7873?n th\u432?\u417?ng m\u7841?i;
\par 3. Ki\u7875?m tra \u273?\u7883?nh k\u7923? ho\u7863?c \u273?\u7897?t xu\u7845?t ho\u7841?t \u273?\u7897?ng c\u7911?a b\u234?n nh\u7853?n quy\u7873?n nh\u7857?m b\u7843?o \u273?\u7843?m s\u7921? th\u7889?ng nh\u7845?t c\u7911?a h\u7879? th\u7889?ng nh\u432?\u7907?ng quy\u7873?n th\u432?\u417?ng m\u7841?i v\u224? s\u7921? \u7893?n \u273?\u7883?nh v\u7873?
 ch\u7845?t l\u432?\u7907?ng h\u224?ng ho\u225?, d\u7883?ch v\u7909?.
\par }\pard\plain \s34\qj \fi709\li0\ri0\sb120\sa180\nowidctlpar\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0 \b\i\f31\fs28\lang1036\langfe1033\cgrid\langnp1036\langfenp1033 {\i0 \u272?i\u7873?u 287.}{ Ngh\u297?a v\u7909? c\u7911?a th\u432?\u417?ng nh\u226?n nh\u432?\u7907?
ng quy\u7873?n
\par }\pard\plain \s35\qj \fi709\li0\ri0\sa120\nowidctlpar\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0 \f31\fs28\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\lang1036\langfe1033\langnp1036 Tr\u7915? tr\u432?\u7901?ng h\u7907?p c\u243? th\u7887?a thu\u7853?n kh\u225?
c, th\u432?\u417?ng nh\u226?n nh\u432?\u7907?ng quy\u7873?n c\u243? c\u225?c ngh\u297?a v\u7909? sau \u273?\u226?y:
\par 1. Cung c\u7845?p t\u224?i li\u7879?u h\u432?\u7899?ng d\u7851?n v\u7873? h\u7879? th\u7889?ng nh\u432?\u7907?ng quy\u7873?n th\u432?\u417?ng m\u7841?i cho b\u234?n nh\u7853?n quy\u7873?n;  
\par 2. \u272?\u224?o t\u7841?o ban \u273?\u7847?u v\u224? cung c\u7845?p tr\u7907? gi\u250?p k\u7929? thu\u7853?t th\u432?\u7901?ng xuy\u234?n cho th\u432?\u417?ng nh\u226?n nh\u7853?n quy\u7873?n \u273?\u7875? \u273?i\u7873?u h\u224?nh ho\u7841?t \u273?\u7897?ng theo \u273?\u250?ng h\u7879? th\u7889?ng nh\u432?\u7907?ng quy\u7873?n th\u432?
\u417?ng m\u7841?i;
\par 3. Thi\u7871?t k\u7871? v\u224? s\u7855?p x\u7871?p \u273?\u7883?a \u273?i\u7875?m b\u225?n h\u224?ng, cung \u7913?ng d\u7883?ch v\u7909? b\u7857?ng chi ph\u237? c\u7911?a th\u432?\u417?ng nh\u226?n nh\u7853?n quy\u7873?n;
\par 4. B\u7843?o \u273?\u7843?m quy\u7873?n s\u7903? h\u7919?u tr\u237? tu\u7879? \u273?\u7889?i v\u7899?i \u273?\u7889?i t\u432?\u7907?ng \u273?\u432?\u7907?c ghi trong h\u7907?p \u273?\u7891?ng nh\u432?\u7907?ng quy\u7873?n;
\par 5. \u272?\u7889?i x\u7917? b\u236?nh \u273?\u7859?ng v\u7899?i c\u225?c th\u432?\u417?ng nh\u226?n nh\u7853?n quy\u7873?n trong h\u7879? th\u7889?ng nh\u432?\u7907?ng quy\u7873?n th\u432?\u417?ng m\u7841?i.
\par }\pard\plain \s34\qj \fi709\li0\ri0\sb120\sa180\nowidctlpar\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0 \b\i\f31\fs28\lang1036\langfe1033\cgrid\langnp1036\langfenp1033 {\i0 \u272?i\u7873?u 288.}{ Quy\u7873?n c\u7911?a th\u432?\u417?ng nh\u226?n nh\u7853?n quy\u7873?n

\par }\pard\plain \s35\qj \fi709\li0\ri0\sa120\nowidctlpar\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0 \f31\fs28\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\lang1036\langfe1033\langnp1036 \tab Tr\u7915? tr\u432?\u7901?ng h\u7907?p c\u243? th\u7887?a thu\u7853?n kh
\u225?c, th\u432?\u417?ng nh\u226?n nh\u7853?n quy\u7873?n c\u243? c\u225?c quy\u7873?n sau \u273?\u226?y:
\par 1. Y\u234?u c\u7847?u th\u432?\u417?ng nh\u226?n nh\u432?\u7907?ng quy\u7873?n cung c\u7845?p \u273?\u7847?y \u273?\u7911? tr\u7907? gi\u250?p k\u7929? thu\u7853?t c\u243? li\u234?n quan \u273?\u7871?n h\u7879? th\u7889?ng nh\u432?\u7907?ng quy\u7873?n th\u432?\u417?ng m\u7841?i;
\par 2. Y\u234?u c\u7847?u th\u432?\u417?ng nh\u226?n nh\u432?\u7907?ng quy\u7873?n \u273?\u7889?i x\u7917? b\u236?nh \u273?\u7859?ng v\u7899?i c\u225?c th\u432?\u417?ng nh\u226?n nh\u7853?n quy\u7873?n kh\u225?c trong h\u7879? th\u7889?ng nh\u432?\u7907?ng quy\u7873?n th\u432?\u417?ng m\u7841?i.
\par }\pard\plain \s34\qj \fi709\li0\ri0\sb120\sa180\nowidctlpar\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0 \b\i\f31\fs28\lang1036\langfe1033\cgrid\langnp1036\langfenp1033 {\i0 \u272?i\u7873?u 289.}{ Ngh\u297?a v\u7909? c\u7911?a th\u432?\u417?ng nh\u226?n nh\u7853?n quy
\u7873?n
\par }\pard\plain \s35\qj \fi709\li0\ri0\sa80\nowidctlpar\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0 \f31\fs28\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {\lang1036\langfe1033\langnp1036 \tab }{\expnd0\expndtw-4\lang1036\langfe1033\langnp1036 Tr
\u7915? tr\u432?\u7901?ng h\u7907?p c\u243? th\u7887?a thu\u7853?n kh\u225?c, th\u432?\u417?ng nh\u226?n nh\u7853?n quy\u7873?n c\u243? c\u225?c ngh\u297?a v\u7909? sau \u273?\u226?y:
\par }{\lang1036\langfe1033\langnp1036 1. Tr\u7843? ti\u7873?n nh\u432?\u7907?ng quy\u7873?n v\u224? c\u225?c kho\u7843?n thanh to\u225?n kh\u225?c theo h\u7907?p \u273?\u7891?ng nh\u432?\u7907?ng quy\u7873?n th\u432?\u417?ng m\u7841?i;
\par 2. \u272?\u7847?u t\u432? \u273?\u7911? c\u417? s\u7903? v\u7853?t ch\u7845?t, ngu\u7891?n t\u224?i ch\u237?nh v\u224? nh\u226?n l\u7921?c \u273?\u7875? ti\u7871?p nh\u7853?n c\u225?c quy\u7873?n v\u224? b\u237? quy\u7871?t kinh doanh m\u224? b\u234?n nh\u432?\u7907?ng quy\u7873?n chuy\u7875?n giao;
\par 3. Ch\u7845?p nh\u7853?n s\u7921? ki\u7875?m so\u225?t, gi\u225?m s\u225?t v\u224? h\u432?\u7899?ng d\u7851?n c\u7911?a b\u234?n nh\u432?\u7907?ng quy\u7873?n; tu\u226?n th\u7911? c\u225?c y\u234?u c\u7847?u v\u7873? thi\u7871?t k\u7871?, s\u7855?p x\u7871?p \u273?\u7883?a \u273?i\u7875?m b\u225?n h\u224?ng, cung \u7913?ng d\u7883?ch v\u7909? c
\u7911?a th\u432?\u417?ng nh\u226?n nh\u432?\u7907?ng quy\u7873?n;
\par 4. Gi\u7919? b\u237? m\u7853?t v\u7873? b\u237? quy\u7871?t kinh doanh \u273?\u227? \u273?\u432?\u7907?c nh\u432?\u7907?ng quy\u7873?n, k\u7875? c\u7843? sau khi h\u7907?p \u273?\u7891?ng nh\u432?\u7907?ng quy\u7873?n th\u432?\u417?ng m\u7841?i k\u7871?t th\u250?c ho\u7863?c ch\u7845?m d\u7913?t;
\par 5. Ng\u7915?ng s\u7917? d\u7909?ng nh\u227?n hi\u7879?u h\u224?ng ho\u225?, t\u234?n th\u432?\u417?ng m\u7841?i, kh\u7849?u hi\u7879?u kinh doanh, bi\u7875?u t\u432?\u7907?ng kinh doanh v\u224? c\u225?c quy\u7873?n s\u7903? h\u7919?u tr\u237? tu\u7879? kh\u225?c (n\u7871?u c\u243?) ho\u7863?c h\u7879? th\u7889?ng c\u7911?a b\u234?
n nh\u432?\u7907?ng quy\u7873?n khi k\u7871?t th\u250?c ho\u7863?c ch\u7845?m d\u7913?t h\u7907?p \u273?\u7891?ng nh\u432?\u7907?ng quy\u7873?n th\u432?\u417?ng m\u7841?i;
\par 6. \u272?i\u7873?u h\u224?nh ho\u7841?t \u273?\u7897?ng ph\u249? h\u7907?p v\u7899?i h\u7879? th\u7889?ng nh\u432?\u7907?ng quy\u7873?n th\u432?\u417?ng m\u7841?i;
\par 7. Kh\u244?ng \u273?\u432?\u7907?c nh\u432?\u7907?ng quy\u7873?n l\u7841?i trong tr\u432?\u7901?ng h\u7907?p kh\u244?ng c\u243? s\u7921? ch\u7845?p thu\u7853?n c\u7911?a b\u234?n nh\u432?\u7907?ng quy\u7873?n.
