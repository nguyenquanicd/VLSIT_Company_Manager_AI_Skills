\par }\pard\plain \s30\qc \li0\ri0\sb300\sa80\nowidctlpar\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0 \b\i\f31\fs28\lang1033\langfe1033\cgrid\langnp1033\langfenp1033 {Ch\'ad\'acng VII
